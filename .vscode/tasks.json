{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run (input/output files)",
            "type": "shell",
            "command": "g++ -std=c++17 -o \"${fileBasenameNoExtension}.exe\" \"${fileBasename}\"; if ($LASTEXITCODE -eq 0) { Get-Content \"input.txt\" | & \".\\${fileBasenameNoExtension}.exe\" | Set-Content \"output.txt\" }",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
